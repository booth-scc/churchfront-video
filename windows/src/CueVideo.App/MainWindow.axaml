<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CueVideo.App.MainWindow"
        Title="Churchfront Video"
        Width="1500" Height="940"
        MinWidth="1280" MinHeight="860"
        Background="#0A0A0C"
        FontFamily="{StaticResource Figtree}"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Grid.Row="0" Padding="22,14" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                    <TextBlock Text="Churchfront" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                    <Border Background="{StaticResource Card}" CornerRadius="999" Padding="3" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Background="{StaticResource ActivePill}" Foreground="#0A0A0C" CornerRadius="999"
                                    Padding="14,5" FontSize="12" FontWeight="Bold" Content="Operator" />
                            <Button x:Name="EngineerButton" Background="Transparent" Foreground="{StaticResource InkDim}" CornerRadius="999"
                                    Padding="14,5" FontSize="12" Content="Engineer" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button x:Name="MoreButton" Classes="ghost" Content="⚙" FontSize="12" Padding="9,5" Width="34" />
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Amber}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="Starting…" FontSize="11" Foreground="{StaticResource InkDim}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" RowDefinitions="*,Auto,Auto" Margin="22,14,22,16">

            <!-- Monitors -->
            <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="16" MinHeight="300">

                <Border Grid.Column="0" BorderBrush="{StaticResource Preview}" BorderThickness="2" CornerRadius="10" ClipToBounds="True" Background="#000000">
                    <Grid>
                        <Border x:Name="NextHost" Background="#000000" />
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                                Background="{StaticResource Preview}" CornerRadius="4" Padding="8,2">
                            <TextBlock Text="NEXT" FontSize="9.5" FontWeight="Bold" LetterSpacing="1.2" Foreground="White" />
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                                Background="#C8000000" CornerRadius="4" Padding="7,3">
                            <TextBlock x:Name="NextSource" Text="" FontSize="11" Foreground="#F2F4F8" />
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1" BorderBrush="{StaticResource Program}" BorderThickness="2" CornerRadius="10" ClipToBounds="True" Background="#000000">
                    <Grid>
                        <Border x:Name="ProgramHost" Background="#000000" />
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                                Background="{StaticResource Program}" CornerRadius="4" Padding="8,2">
                            <TextBlock Text="LIVE" FontSize="9.5" FontWeight="Bold" LetterSpacing="1.2" Foreground="White" />
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                                Background="#C8000000" CornerRadius="4" Padding="7,3">
                            <TextBlock x:Name="ProgramSource" Text="" FontSize="11" Foreground="#F2F4F8" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Source thumbnails -->
            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                <StackPanel x:Name="SourceTiles" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Bottom bar -->
            <Grid Grid.Row="2" ColumnDefinitions="272,300,*,296" ColumnSpacing="16" Margin="0,14,0,0" Height="236">

                <!-- Camera chip + exposure -->
                <StackPanel Grid.Column="0" Spacing="7">
                    <Border Background="#0E2A16" BorderBrush="#2E7D3B" BorderThickness="1" CornerRadius="7" Padding="9,6" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="11" Height="11" CornerRadius="2" Background="{StaticResource Preview}" VerticalAlignment="Center" />
                            <TextBlock x:Name="CameraChipName" Text="Cam 1" FontSize="11.5" FontWeight="Bold" Foreground="#EFF7F0" VerticalAlignment="Center" />
                            <Border Background="{StaticResource Preview}" CornerRadius="3" Padding="6,1">
                                <TextBlock Text="ON NEXT" FontSize="8.5" FontWeight="Bold" Foreground="#0A0A0C" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                        <TextBlock Grid.Column="0" Text="EXPOSURE" Classes="label" VerticalAlignment="Center" />
                        <Button x:Name="ExposureAutoButton" Grid.Column="1" Classes="ghost" Content="Auto" FontSize="9" Padding="8,2" />
                    </Grid>

                    <Grid ColumnDefinitions="52,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="3">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Gain" FontSize="10" Foreground="{StaticResource Muted}" />
                        <TextBlock x:Name="ExposureGain" Grid.Row="0" Grid.Column="1" Text="—" FontSize="11" Foreground="{StaticResource InkDim}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Shutter" FontSize="10" Foreground="{StaticResource Muted}" />
                        <TextBlock x:Name="ExposureShutter" Grid.Row="1" Grid.Column="1" Text="—" FontSize="11" Foreground="{StaticResource InkDim}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Iris" FontSize="10" Foreground="{StaticResource Muted}" />
                        <TextBlock x:Name="ExposureIris" Grid.Row="2" Grid.Column="1" Text="—" FontSize="11" Foreground="{StaticResource InkDim}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="White" FontSize="10" Foreground="{StaticResource Muted}" />
                        <TextBlock x:Name="ExposureWhite" Grid.Row="3" Grid.Column="1" Text="—" FontSize="11" Foreground="{StaticResource InkDim}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="ExposureCamText" Grid.Column="0" Text="Cam 1 exposure" FontSize="9.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Save" FontSize="9.5" Foreground="{StaticResource Muted}" />
                    </Grid>
                </StackPanel>

                <!-- Shots -->
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="SHOTS" Classes="label" />
                    <StackPanel x:Name="ShotRows" Spacing="5" />
                </StackPanel>

                <!-- Framing -->
                <Grid Grid.Column="2" RowDefinitions="*,Auto" Margin="4,0,4,0">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">

                        <Border Width="150" Height="150" CornerRadius="75" Background="#121316"
                                BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*,*" Margin="8">
                                <Button x:Name="PanUpLeft" Grid.Row="0" Grid.Column="0" Classes="pad" Content="↖" />
                                <Button x:Name="PanUp" Grid.Row="0" Grid.Column="1" Classes="pad" Content="↑" />
                                <Button x:Name="PanUpRight" Grid.Row="0" Grid.Column="2" Classes="pad" Content="↗" />
                                <Button x:Name="PanLeft" Grid.Row="1" Grid.Column="0" Classes="pad" Content="←" />
                                <Ellipse Grid.Row="1" Grid.Column="1" Width="34" Height="34" Fill="#25282F" IsHitTestVisible="False" />
                                <Button x:Name="PanRight" Grid.Row="1" Grid.Column="2" Classes="pad" Content="→" />
                                <Button x:Name="PanDownLeft" Grid.Row="2" Grid.Column="0" Classes="pad" Content="↙" />
                                <Button x:Name="PanDown" Grid.Row="2" Grid.Column="1" Classes="pad" Content="↓" />
                                <Button x:Name="PanDownRight" Grid.Row="2" Grid.Column="2" Classes="pad" Content="↘" />
                            </Grid>
                        </Border>

                        <Border Width="42" Height="126" CornerRadius="21" Background="#121316"
                                BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <Grid RowDefinitions="*,Auto,*">
                                <Button x:Name="ZoomInButton" Grid.Row="0" Classes="pad" Content="+" FontSize="15" />
                                <Ellipse Grid.Row="1" Width="20" Height="20" Fill="#2A2D34" IsHitTestVisible="False" />
                                <Button x:Name="ZoomOutButton" Grid.Row="2" Classes="pad" Content="−" FontSize="15" />
                            </Grid>
                        </Border>

                        <StackPanel Spacing="8" VerticalAlignment="Center" Width="132">
                            <Button x:Name="FocusButton" Classes="ghost" Content="Focus" FontSize="11" Height="38" />
                            <Button x:Name="TrackButton" Classes="ghost" Content="Track" FontSize="11" Height="38" IsEnabled="False" />
                            <TextBlock Text="Or click a person on Next" FontSize="8.5" Foreground="{StaticResource Muted}"
                                       TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,6,0,0">
                        <CheckBox x:Name="AutoTrackCheck" Grid.Column="0" Content="Auto tracking on stage" FontSize="9.5" IsEnabled="False" />
                        <Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="0.25" Maximum="2" Value="1" VerticalAlignment="Center"
                                Foreground="{StaticResource Preview}" />
                        <TextBlock x:Name="SpeedText" Grid.Column="2" Text="1.0×" FontSize="10" Foreground="{StaticResource InkDim}" VerticalAlignment="Center" />
                        <Button x:Name="ResetSpeedButton" Grid.Column="3" Classes="ghost" Content="Reset" FontSize="9" Padding="8,3" />
                    </Grid>
                </Grid>

                <!-- Take it live -->
                <Grid Grid.Column="3" RowDefinitions="Auto,Auto" RowSpacing="8">
                    <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button x:Name="AutoButton" Grid.Column="0" Classes="take" Background="{StaticResource Program}" Height="104">
                            <StackPanel Spacing="2">
                                <TextBlock Text="FADE" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" />
                                <TextBlock x:Name="FadeSub" Text="1.0 s · Return" FontSize="9" HorizontalAlignment="Center" Foreground="#FFD7D3" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CutButton" Grid.Column="1" Classes="take" Height="104">
                            <StackPanel Spacing="2">
                                <TextBlock Text="CUT" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource Ink}" />
                                <TextBlock Text="Space" FontSize="9" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button x:Name="BlackButton" Grid.Column="0" Classes="take" Height="60">
                            <StackPanel Spacing="1">
                                <TextBlock Text="BLACK" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource Ink}" />
                                <TextBlock x:Name="BlackSub" Text="Off" FontSize="8.5" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="LowerThirdsButton" Grid.Column="1" Classes="take" Height="60" IsEnabled="False">
                            <StackPanel Spacing="1">
                                <TextBlock Text="LOWER THIRDS" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource Ink}" />
                                <TextBlock Text="Off" FontSize="8.5" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
