<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CueVideo.App.MainWindow"
        Title="Churchfront Video"
        Width="1500" Height="940"
        MinWidth="1240" MinHeight="820"
        Background="{StaticResource Canvas}"
        FontFamily="{StaticResource Figtree}"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" Padding="22,14" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                    <TextBlock Text="Churchfront" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />

                    <Border Background="{StaticResource Card}" CornerRadius="999" Padding="3" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Background="{StaticResource ActivePill}" Foreground="#0A0A0C" CornerRadius="999"
                                    Padding="14,5" FontSize="12" FontWeight="Bold" Content="Operator" />
                            <Button Background="Transparent" Foreground="{StaticResource InkDim}" CornerRadius="999"
                                    Padding="14,5" FontSize="12" IsEnabled="False" Content="Engineer" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="{StaticResource Card}" CornerRadius="999" Padding="11,6" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse x:Name="AtemDot" Width="7" Height="7" Fill="{StaticResource Amber}" VerticalAlignment="Center" />
                            <TextBlock x:Name="AtemChipText" Text="ATEM OFFLINE" FontSize="10" FontWeight="SemiBold" LetterSpacing="1" Foreground="{StaticResource InkDim}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Card}" CornerRadius="999" Padding="11,6" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse x:Name="NdiDot" Width="7" Height="7" Fill="{StaticResource Amber}" VerticalAlignment="Center" />
                            <TextBlock x:Name="NdiChipText" Text="NDI CHECKING" FontSize="10" FontWeight="SemiBold" LetterSpacing="1" Foreground="{StaticResource InkDim}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Card}" CornerRadius="999" Padding="11,6" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Amber}" VerticalAlignment="Center" />
                            <TextBlock Text="CAMERAS OFFLINE" FontSize="10" FontWeight="SemiBold" LetterSpacing="1" Foreground="{StaticResource InkDim}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main -->
        <Grid Grid.Row="1" Margin="20,16,20,10" RowDefinitions="*,Auto,Auto">

            <!-- Monitors: NEXT left, LIVE right -->
            <Grid Grid.Row="0" ColumnDefinitions="1.12*,*" ColumnSpacing="16">

                <Border Grid.Column="0" Classes="card" BorderBrush="{StaticResource Preview}" BorderThickness="2"
                        CornerRadius="14" ClipToBounds="True">
                    <Grid>
                        <Border x:Name="NextHost" Background="#060608">
                            <TextBlock Text="NO SIGNAL" FontSize="12" LetterSpacing="2" Foreground="#2F333B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14"
                                Background="{StaticResource Preview}" CornerRadius="5" Padding="8,3">
                            <TextBlock Text="NEXT" FontSize="9.5" FontWeight="Bold" LetterSpacing="1.2" Foreground="White" />
                        </Border>
                        <TextBlock x:Name="NextSource" Text="" FontSize="11" Foreground="{StaticResource InkDim}"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,12" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Classes="card" BorderBrush="{StaticResource Program}" BorderThickness="2"
                        CornerRadius="14" ClipToBounds="True">
                    <Grid>
                        <Border x:Name="ProgramHost" Background="#060608">
                            <TextBlock Text="NO SIGNAL" FontSize="12" LetterSpacing="2" Foreground="#2F333B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14"
                                Background="{StaticResource Program}" CornerRadius="5" Padding="8,3">
                            <TextBlock Text="LIVE" FontSize="9.5" FontWeight="Bold" LetterSpacing="1.2" Foreground="White" />
                        </Border>
                        <TextBlock x:Name="ProgramSource" Text="" FontSize="11" Foreground="{StaticResource InkDim}"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,12" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Pick what's next -->
            <StackPanel Grid.Row="1" Spacing="8" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Border Width="18" Height="18" CornerRadius="9" Background="#1E2025">
                        <TextBlock Text="1" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource InkDim}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="PICK WHAT'S NEXT" Classes="label" VerticalAlignment="Center" />
                </StackPanel>
                <UniformGrid x:Name="SourceRow" Columns="6" Height="84" />
            </StackPanel>

            <!-- Bottom row -->
            <Grid Grid.Row="2" ColumnDefinitions="392,*,336" ColumnSpacing="16" Margin="0,16,0,0">

                <!-- Shots + exposure -->
                <Border Grid.Column="0" Classes="card" Padding="14">
                    <Grid RowDefinitions="Auto,Auto,Auto,*">
                        <StackPanel x:Name="CameraChips" Orientation="Horizontal" Spacing="6" />

                        <StackPanel Grid.Row="1" Margin="0,14,0,0" Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="EXPOSURE" Classes="label" VerticalAlignment="Center" />
                                <Button x:Name="ExposureAutoButton" Grid.Column="1" Classes="ghost" Content="Auto"
                                        FontSize="9.5" Padding="9,3" />
                            </Grid>
                            <Grid ColumnDefinitions="54,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="3">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Gain" FontSize="10" Foreground="{StaticResource Muted}" />
                                <TextBlock x:Name="ExposureGain" Grid.Row="0" Grid.Column="1" Text="—" FontSize="10.5" Foreground="{StaticResource InkDim}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Shutter" FontSize="10" Foreground="{StaticResource Muted}" />
                                <TextBlock x:Name="ExposureShutter" Grid.Row="1" Grid.Column="1" Text="—" FontSize="10.5" Foreground="{StaticResource InkDim}" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Iris" FontSize="10" Foreground="{StaticResource Muted}" />
                                <TextBlock x:Name="ExposureIris" Grid.Row="2" Grid.Column="1" Text="—" FontSize="10.5" Foreground="{StaticResource InkDim}" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="White" FontSize="10" Foreground="{StaticResource Muted}" />
                                <TextBlock x:Name="ExposureWhite" Grid.Row="3" Grid.Column="1" Text="—" FontSize="10.5" Foreground="{StaticResource InkDim}" />
                            </Grid>
                        </StackPanel>

                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,14,0,8">
                            <TextBlock Grid.Column="0" Text="SHOTS" Classes="label" />
                            <TextBlock Grid.Column="1" Text="TWO NAMED SHOTS PER CAMERA" FontSize="9" Foreground="{StaticResource Muted}" />
                        </Grid>

                        <Grid Grid.Row="3" RowDefinitions="*,Auto">
                            <StackPanel x:Name="ShotRows" Spacing="6" />

                            <UniformGrid Grid.Row="1" Columns="7" Margin="0,8,0,0">
                                <Button x:Name="Preset1Button" Classes="shot" Content="1" Height="30" FontSize="10" />
                                <Button x:Name="Preset2Button" Classes="shot" Content="2" Height="30" FontSize="10" />
                                <Button x:Name="Preset3Button" Classes="shot" Content="3" Height="30" FontSize="10" />
                                <Button x:Name="Preset4Button" Classes="shot" Content="4" Height="30" FontSize="10" />
                                <Button x:Name="Preset5Button" Classes="shot" Content="5" Height="30" FontSize="10" />
                                <Button x:Name="Preset6Button" Classes="shot" Content="6" Height="30" FontSize="10" />
                                <Button x:Name="Preset7Button" Classes="shot" Content="7" Height="30" FontSize="10" />
                            </UniformGrid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Frame -->
                <Border Grid.Column="1" Classes="card" Padding="14">
                    <Grid RowDefinitions="Auto,*,Auto">

                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <Border Width="18" Height="18" CornerRadius="9" Background="#1E2025">
                                    <TextBlock Text="2" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource InkDim}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="FRAME" Classes="label" VerticalAlignment="Center" />
                                <TextBlock x:Name="CameraNextName" Text="—" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="2" Classes="ghost" Content="Exposure" FontSize="10.5"
                                    Padding="10,5" IsEnabled="False" />
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="14" Margin="0,12,0,0">

                            <Border Grid.Column="0" Width="186" Height="186" CornerRadius="93"
                                    Background="#101114" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*,*" Margin="6">
                                    <Button x:Name="PanUpLeft" Grid.Row="0" Grid.Column="0" Classes="pad" Content="↖" />
                                    <Button x:Name="PanUp" Grid.Row="0" Grid.Column="1" Classes="pad" Content="↑" />
                                    <Button x:Name="PanUpRight" Grid.Row="0" Grid.Column="2" Classes="pad" Content="↗" />
                                    <Button x:Name="PanLeft" Grid.Row="1" Grid.Column="0" Classes="pad" Content="←" />
                                    <Ellipse Grid.Row="1" Grid.Column="1" Width="46" Height="46" Fill="#25282F" IsHitTestVisible="False" />
                                    <Button x:Name="PanRight" Grid.Row="1" Grid.Column="2" Classes="pad" Content="→" />
                                    <Button x:Name="PanDownLeft" Grid.Row="2" Grid.Column="0" Classes="pad" Content="↙" />
                                    <Button x:Name="PanDown" Grid.Row="2" Grid.Column="1" Classes="pad" Content="↓" />
                                    <Button x:Name="PanDownRight" Grid.Row="2" Grid.Column="2" Classes="pad" Content="↘" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Width="50" Height="150" CornerRadius="25"
                                    Background="{StaticResource CardRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid RowDefinitions="*,Auto,*">
                                    <Button x:Name="ZoomInButton" Grid.Row="0" Classes="pad" Content="+" FontSize="17" />
                                    <Ellipse Grid.Row="1" Width="26" Height="26" Fill="#2A2D34" IsHitTestVisible="False" />
                                    <Button x:Name="ZoomOutButton" Grid.Row="2" Classes="pad" Content="−" FontSize="17" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center" MinWidth="168">
                                <Button x:Name="PanHome" Classes="ghost" Content="Home" FontSize="10.5" Padding="10,5" HorizontalAlignment="Stretch" />
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="5">
                                    <Button x:Name="FocusNearButton" Grid.Column="0" Classes="ghost" Content="N" FontSize="10.5" Padding="6,5" />
                                    <Button x:Name="FocusAutoButton" Grid.Column="1" Classes="ghost" Content="A" FontSize="10.5" Padding="6,5" />
                                    <Button x:Name="FocusFarButton" Grid.Column="2" Classes="ghost" Content="F" FontSize="10.5" Padding="6,5" />
                                </Grid>

                                <Border Background="#101114" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="9">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="TRACKING" Classes="label" />
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                                            <Button Grid.Column="0" Classes="ghost" Content="C" FontSize="9.5" Padding="4,3" IsEnabled="False" />
                                            <Button Grid.Column="1" Classes="ghost" Content="S" FontSize="9.5" Padding="4,3" IsEnabled="False" />
                                            <Button Grid.Column="2" Classes="ghost" Content="F" FontSize="9.5" Padding="4,3" IsEnabled="False" />
                                        </Grid>
                                        <TextBlock Text="Following: full length" FontSize="9" Foreground="{StaticResource Muted}" />
                                        <CheckBox Content="Auto tracking" FontSize="9.5" IsEnabled="False" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Margin="0,12,0,0">
                            <TextBlock Grid.Column="0" Text="PAN · TILT · ZOOM" Classes="label" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0.25" Maximum="2" Value="1" IsEnabled="False" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="1.0×" FontSize="10.5" Foreground="{StaticResource InkDim}" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Classes="ghost" Content="Reset" FontSize="10" Padding="9,4" IsEnabled="False" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Take it live -->
                <Border Grid.Column="2" Classes="card" Padding="14">
                    <Grid RowDefinitions="Auto,*,Auto">

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="18" Height="18" CornerRadius="9" Background="#1E2025">
                                <TextBlock Text="3" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource InkDim}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="TAKE IT LIVE" Classes="label" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Spacing="8" Margin="0,12,0,0">
                            <Button x:Name="AutoButton" Classes="take" Background="{StaticResource Program}"
                                    Foreground="White" Height="82" FontSize="20">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="FADE" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" />
                                    <TextBlock Text="1.0 s mix" FontSize="9.5" HorizontalAlignment="Center" Foreground="#FFD7D3" />
                                </StackPanel>
                            </Button>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button x:Name="CutButton" Grid.Column="0" Classes="take" Content="CUT" Height="52" />
                                <Button x:Name="BlackButton" Grid.Column="1" Classes="take" Content="BLACK" Height="52" />
                            </Grid>
                        </StackPanel>

                        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" Margin="0,12,0,0">
                            <TextBlock Text="KEYS" Classes="label" Margin="0,0,0,6" />
                            <UniformGrid x:Name="KeyRow" Grid.Row="1" Columns="2" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="22,8" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="FooterStatus" Grid.Column="0" Text="Connecting…" FontSize="10.5" Foreground="{StaticResource Muted}" />
                <TextBlock Grid.Column="1" Text="0.1.0 · windows" FontSize="10.5" Foreground="{StaticResource Muted}" />
            </Grid>
        </Border>
    </Grid>
</Window>
