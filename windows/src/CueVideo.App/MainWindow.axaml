<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CueVideo.App.MainWindow"
        Title="Churchfront Video"
        Width="1500" Height="940"
        MinWidth="1240" MinHeight="820"
        Background="{StaticResource Canvas}"
        FontFamily="{StaticResource Figtree}"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Grid.Row="0" Padding="24,16" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                    <TextBlock Text="Churchfront" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Ink}" VerticalAlignment="Center" />

                    <Border Background="{StaticResource Card}" CornerRadius="999" Padding="3" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Background="{StaticResource ActivePill}" Foreground="#0A0A0C" CornerRadius="999"
                                    Padding="14,5" FontSize="12" FontWeight="Bold" Content="Operator" />
                            <Button Background="Transparent" Foreground="{StaticResource InkDim}" CornerRadius="999"
                                    Padding="14,5" FontSize="12" IsEnabled="False" Content="Engineer" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Amber}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="Starting…" FontSize="11" Foreground="{StaticResource InkDim}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main -->
        <Grid Grid.Row="1" Margin="24,18,24,20" RowDefinitions="*,Auto,Auto">

            <!-- Monitors: next left, live right -->
            <Grid Grid.Row="0" ColumnDefinitions="1.12*,*" ColumnSpacing="18">

                <Border Grid.Column="0" Classes="card" BorderBrush="{StaticResource Preview}" BorderThickness="2"
                        CornerRadius="14" ClipToBounds="True">
                    <Grid>
                        <Border x:Name="NextHost" Background="#060608">
                            <TextBlock Text="NO SIGNAL" FontSize="12" LetterSpacing="2" Foreground="#2F333B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16"
                                Background="{StaticResource Preview}" CornerRadius="5" Padding="9,3">
                            <TextBlock Text="NEXT" FontSize="10" FontWeight="Bold" LetterSpacing="1.3" Foreground="White" />
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,12"
                                Background="#B3000000" CornerRadius="4" Padding="7,3">
                            <TextBlock x:Name="NextSource" Text="" FontSize="11" Foreground="#E6E8EC" />
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Classes="card" BorderBrush="{StaticResource Program}" BorderThickness="2"
                        CornerRadius="14" ClipToBounds="True">
                    <Grid>
                        <Border x:Name="ProgramHost" Background="#060608">
                            <TextBlock Text="NO SIGNAL" FontSize="12" LetterSpacing="2" Foreground="#2F333B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16"
                                Background="{StaticResource Program}" CornerRadius="5" Padding="9,3">
                            <TextBlock Text="LIVE" FontSize="10" FontWeight="Bold" LetterSpacing="1.3" Foreground="White" />
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,12"
                                Background="#B3000000" CornerRadius="4" Padding="7,3">
                            <TextBlock x:Name="ProgramSource" Text="" FontSize="11" Foreground="#E6E8EC" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Pick what's next -->
            <StackPanel Grid.Row="1" Spacing="10" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Border Width="18" Height="18" CornerRadius="9" Background="#1E2025">
                        <TextBlock Text="1" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource InkDim}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="PICK WHAT'S NEXT" Classes="label" VerticalAlignment="Center" />
                </StackPanel>
                <UniformGrid x:Name="SourceRow" Columns="6" Height="76" />
            </StackPanel>

            <!-- Two jobs -->
            <Grid Grid.Row="2" ColumnDefinitions="1.35*,1*" ColumnSpacing="18" Margin="0,18,0,0">

                <Border Grid.Column="0" Classes="card" Padding="18">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="18">

                        <Border Grid.Column="0" Width="176" Height="176" CornerRadius="88"
                                Background="#101114" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*,*" Margin="6">
                                <Button x:Name="PanUpLeft" Grid.Row="0" Grid.Column="0" Classes="pad" Content="↖" />
                                <Button x:Name="PanUp" Grid.Row="0" Grid.Column="1" Classes="pad" Content="↑" />
                                <Button x:Name="PanUpRight" Grid.Row="0" Grid.Column="2" Classes="pad" Content="↗" />
                                <Button x:Name="PanLeft" Grid.Row="1" Grid.Column="0" Classes="pad" Content="←" />
                                <Ellipse Grid.Row="1" Grid.Column="1" Width="44" Height="44" Fill="#25282F" IsHitTestVisible="False" />
                                <Button x:Name="PanRight" Grid.Row="1" Grid.Column="2" Classes="pad" Content="→" />
                                <Button x:Name="PanDownLeft" Grid.Row="2" Grid.Column="0" Classes="pad" Content="↙" />
                                <Button x:Name="PanDown" Grid.Row="2" Grid.Column="1" Classes="pad" Content="↓" />
                                <Button x:Name="PanDownRight" Grid.Row="2" Grid.Column="2" Classes="pad" Content="↘" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Width="46" Height="140" CornerRadius="23"
                                Background="{StaticResource CardRaised}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid RowDefinitions="*,Auto,*">
                                <Button x:Name="ZoomInButton" Grid.Row="0" Classes="pad" Content="+" FontSize="17" />
                                <Ellipse Grid.Row="1" Width="24" Height="24" Fill="#2A2D34" IsHitTestVisible="False" />
                                <Button x:Name="ZoomOutButton" Grid.Row="2" Classes="pad" Content="−" FontSize="17" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="18" Height="18" CornerRadius="9" Background="#1E2025">
                                    <TextBlock Text="2" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource InkDim}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="FRAME" Classes="label" VerticalAlignment="Center" />
                                <TextBlock x:Name="CameraNextName" Text="—" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel x:Name="ShotPanel" Spacing="6" Margin="0,8,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="3" Spacing="8" VerticalAlignment="Center" MinWidth="150">
                            <Button x:Name="HomeButton" Classes="ghost" Content="Home" FontSize="11" />
                            <Button x:Name="MoreButton" Classes="ghost" Content="More…" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Classes="card" Padding="18">
                    <Grid RowDefinitions="Auto,*,Auto">

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="18" Height="18" CornerRadius="9" Background="#1E2025">
                                <TextBlock Text="3" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource InkDim}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="TAKE IT LIVE" Classes="label" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Spacing="10" Margin="0,14,0,0">
                            <Button x:Name="AutoButton" Classes="take" Background="{StaticResource Program}"
                                    Foreground="White" Height="118" FontSize="26">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="FADE" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" />
                                    <TextBlock Text="1.0 s mix" FontSize="10" HorizontalAlignment="Center" Foreground="#FFD7D3" />
                                </StackPanel>
                            </Button>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button x:Name="CutButton" Grid.Column="0" Classes="take" Content="CUT" Height="64" FontSize="17" />
                                <Button x:Name="BlackButton" Grid.Column="1" Classes="take" Content="BLACK" Height="64" FontSize="17" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
