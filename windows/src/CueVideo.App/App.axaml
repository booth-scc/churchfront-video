<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CueVideo.App.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <SolidColorBrush x:Key="Ink">#F2F4F8</SolidColorBrush>
        <SolidColorBrush x:Key="InkDim">#8A90A0</SolidColorBrush>
        <SolidColorBrush x:Key="Canvas">#0B0C0F</SolidColorBrush>
        <SolidColorBrush x:Key="Panel">#14161C</SolidColorBrush>
        <SolidColorBrush x:Key="PanelRaised">#1C1F27</SolidColorBrush>
        <SolidColorBrush x:Key="Line">#262A34</SolidColorBrush>
        <SolidColorBrush x:Key="Program">#E0362C</SolidColorBrush>
        <SolidColorBrush x:Key="Preview">#2FA84F</SolidColorBrush>
        <SolidColorBrush x:Key="Amber">#D79A2B</SolidColorBrush>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource InkDim}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LetterSpacing" Value="1.2" />
        </Style>

        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="{StaticResource PanelRaised}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#242833" />
        </Style>

        <Style Selector="Button.tally">
            <Setter Property="Background" Value="{StaticResource PanelRaised}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,14" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.transport">
            <Setter Property="Background" Value="{StaticResource PanelRaised}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Height" Value="56" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Application.Styles>
</Application>
