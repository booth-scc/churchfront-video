<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CueVideo.App.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <FontFamily x:Key="Figtree">avares://CueVideo.App/Assets/Figtree.ttf#Figtree</FontFamily>

        <SolidColorBrush x:Key="Canvas">#0A0A0C</SolidColorBrush>
        <SolidColorBrush x:Key="Card">#131417</SolidColorBrush>
        <SolidColorBrush x:Key="CardRaised">#1A1C20</SolidColorBrush>
        <SolidColorBrush x:Key="Line">#23252A</SolidColorBrush>
        <SolidColorBrush x:Key="Ink">#F4F5F7</SolidColorBrush>
        <SolidColorBrush x:Key="InkDim">#9AA0AA</SolidColorBrush>
        <SolidColorBrush x:Key="Muted">#767C87</SolidColorBrush>
        <SolidColorBrush x:Key="Program">#E0453A</SolidColorBrush>
        <SolidColorBrush x:Key="Preview">#6FCF7A</SolidColorBrush>
        <SolidColorBrush x:Key="Amber">#F2C14E</SolidColorBrush>
        <SolidColorBrush x:Key="ActivePill">#DDE7F2</SolidColorBrush>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource Figtree}" />
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="LetterSpacing" Value="1.6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource Card}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="{StaticResource CardRaised}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#23262C" />
        </Style>

        <Style Selector="Button.pad">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.pad:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#22252B" />
        </Style>

        <Style Selector="Button.take">
            <Setter Property="Background" Value="{StaticResource CardRaised}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.shot">
            <Setter Property="Background" Value="{StaticResource CardRaised}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </Application.Styles>
</Application>
