<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia.Headless.XUnit 12 is built against xunit v3; the Core tests stay on v2. -->
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.6" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CueVideo.App\CueVideo.App.csproj" />
    <ProjectReference Include="..\..\src\CueVideo.Core\CueVideo.Core.csproj" />
    <ProjectReference Include="..\CueVideo.TestSupport\CueVideo.TestSupport.csproj" />
  </ItemGroup>

</Project>
